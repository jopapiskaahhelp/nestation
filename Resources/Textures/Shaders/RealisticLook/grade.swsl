
uniform sampler2D SCREEN_TEXTURE;

uniform highp float exposure;
uniform highp float contrast;
uniform highp float saturation;
uniform highp float shadowDesat;
uniform highp float blackCrush;
uniform highp float tonemapAmount;

uniform highp float shadowR;
uniform highp float shadowG;
uniform highp float shadowB;
uniform highp float highlightR;
uniform highp float highlightG;
uniform highp float highlightB;

uniform highp float vignetteStrength;
uniform highp float vignetteRadius;
uniform highp float vignetteSoftness;

uniform highp float grainStrength;
uniform highp float grainSize;
uniform highp float aberration;

highp float luma(highp vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

highp float hash12(highp vec2 p) {
    highp vec3 p3 = fract(vec3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, vec3(p3.y, p3.z, p3.x) + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

highp vec3 acesFilm(highp vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

void fragment() {
    highp vec2 res = 1.0 / SCREEN_PIXEL_SIZE.xy;
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp float aspect = res.x / res.y;
    highp vec2 dir = uv - 0.5;
    highp float dist = length(dir * vec2(aspect, 1.0));

    highp vec2 caOff = dir * (aberration * dist);
    highp vec3 src;
    src.r = zTextureSpec(SCREEN_TEXTURE, uv + caOff).r;
    src.g = zTextureSpec(SCREEN_TEXTURE, uv).g;
    src.b = zTextureSpec(SCREEN_TEXTURE, uv - caOff).b;

    highp vec3 lin = pow(max(src, vec3(0.0)), vec3(2.2)) * exposure;

    highp float l = luma(lin);
    highp float w = smoothstep(0.0, 0.35, l);
    lin *= mix(vec3(shadowR, shadowG, shadowB), vec3(highlightR, highlightG, highlightB), w);

    highp float sat = saturation * mix(1.0 - shadowDesat, 1.0, smoothstep(0.0, 0.2, l));
    highp float lg = luma(lin);
    lin = max(mix(vec3(lg), lin, sat), vec3(0.0));

    lin = mix(clamp(lin, 0.0, 1.0), acesFilm(lin), tonemapAmount);

    highp vec3 col = pow(clamp(lin, 0.0, 1.0), vec3(1.0 / 2.2));

    col = clamp((col - 0.4) * contrast + 0.4, 0.0, 1.0);
    col = max(col - blackCrush, 0.0) / max(1.0 - blackCrush, 0.001);

    highp float vig = 1.0 - smoothstep(vignetteRadius, vignetteRadius + vignetteSoftness, dist);
    col *= mix(1.0, vig, vignetteStrength);

    highp float gs = max(grainSize * res.y / 1080.0, 1.0);
    highp float t = mod(floor(TIME * 24.0), 64.0);
    highp vec2 gp = floor(FRAGCOORD.xy / gs) + vec2(t * 37.17, t * 91.3);
    highp float n = hash12(gp) + hash12(gp + 17.1) - 1.0;
    highp float gw = 1.0 - smoothstep(0.0, 0.85, luma(col)) * 0.7;
    col += vec3(n * grainStrength * gw);

    COLOR = vec4(clamp(col, 0.0, 1.0), 1.0);
}
