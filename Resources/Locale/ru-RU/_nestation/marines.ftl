name-format-marine = Pvt. { $part0 } { $part1 }

ent-MobMarine = рядовой морпех
    .desc = Рядовой наёмник-пехотинец, участник высадки против ксеносов.
ent-WeaponRifleLecterMarine = { ent-WeaponRifleLecter }
    .desc = { ent-WeaponRifleLecter.desc }
ent-MarineSpawnZone = зона спавна морпехов
    .desc = { ent-MarkerBase.desc }
ent-MarineFlagpole = флагшток
    .desc = Сюда морпехи поднимают флаг демократии. Каждый поднятый флаг вызывает подкрепление.
ent-MarineMissionTablet = планшет миссии
    .desc = Планшет, с которого начинается высадка.
ent-MarineGate = десантный шлюз
    .desc = Длинный шлюз, открывающийся после начала миссии.
ent-MarineGateSegment = десантный шлюз
    .desc = { ent-MarineGate.desc }

marine-mission-title = Высадка
marine-mission-start = Начать миссию
marine-mission-status-ready = Шлюз закрыт. Миссия не начата.
marine-mission-status-started = Миссия идёт. Высажено: { $spawned } / { $total }

ent-MarineSupplyLift = подъёмник снабжения
    .desc = Грузовая платформа 2x3. Заказанные припасы приезжают на ней: она уходит в пол и возвращается с грузом.
ent-MarineParachuteCanopy = парашют
    .desc = Купол парашюта десантника.
ent-MarineSupplyConsole = консоль снабжения
    .desc = Заказ оружия и снаряжения для высадки. Кредиты начисляются за поднятые флаги.

marine-flag-reward = Флаг поднят! Командование начислило { $credits } кр. Баланс снабжения: { $balance } кр.
marine-supply-title = Консоль снабжения
marine-supply-credits = Кредиты: { $credits }
marine-supply-order = Заказать
marine-supply-status-ready = Подъёмник готов к заказам.
marine-supply-status-pending = Доставка через { $seconds } с. Предметов в заказе: { $count }. Можно добавлять заказы.
marine-supply-status-moving = Подъёмник в пути. Заказы временно недоступны.
